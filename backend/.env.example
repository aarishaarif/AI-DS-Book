# ============================================================
# AI & Data Science Learning Book — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
#
# ============================================================

# ── Google Gemini ────────────────────────────────────────────
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model — verified against official docs
# https://ai.google.dev/gemini-api/docs/embeddings
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Generation model
# https://ai.google.dev/gemini-api/docs/models/gemini
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# ── Qdrant Vector Database ───────────────────────────────────
# Set these to the existing Qdrant Cloud values in backend/.env or the
# deployment secret store. These placeholders are not credentials.
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION_NAME=ai_ds_book

# Gemini Embedding 001 output size. 768 is a documented recommended size.
EMBEDDING_DIMENSION=768

# ── FastAPI Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── RAG Pipeline Tuning ──────────────────────────────────────
# Target token size per chunk (400–800 recommended)
CHUNK_SIZE=800

# Overlapping tokens between adjacent chunks (50–120 recommended)
CHUNK_OVERLAP=100

# Minimum relevance score (0–1) to accept retrieved chunks
EVIDENCE_THRESHOLD=0.7
RETRIEVAL_LIMIT=6

# ── Book Content ─────────────────────────────────────────────
# Path to the directory containing Markdown/MDX book files.
# Relative to the backend/ directory.
BOOK_DIR=../frontend/docs
